# Copy to .env (used by docker compose) or export before running the server.
GEMINI_API_KEY=
# gemini | fake  (defaults to gemini when GEMINI_API_KEY is set, fake otherwise)
LLM_PROVIDER=
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash
# Required unless DJANGO_DEBUG=1 (signs JWTs). Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=
# 1 = debug mode with a built-in dev secret key; local development only
DJANGO_DEBUG=0
# 1 = create demo users and classes on startup (docker compose)
SEED_DEMO=0
